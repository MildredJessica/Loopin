# ─── Stage 1: Build with Maven ────────────────────────────────────────────────
FROM eclipse-temurin:23-jdk-alpine AS builder
WORKDIR /workspace

# Copy parent pom and all module poms first (better layer caching)
COPY pom.xml .
COPY api-gateway/pom.xml api-gateway/
COPY user-service/pom.xml user-service/
COPY post-service/pom.xml post-service/
COPY notification-service/pom.xml notification-service/
COPY message-service/pom.xml message-service/
COPY .mvn/ .mvn/
COPY mvnw .

# Pre-download dependencies
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B --no-transfer-progress 2>/dev/null || true

# Copy all source code
COPY api-gateway/src api-gateway/src
COPY user-service/src user-service/src
COPY post-service/src post-service/src
COPY notification-service/src notification-service/src
COPY message-service/src message-service/src

# Build all modules (skip tests for speed)
RUN ./mvnw package -DskipTests -B --no-transfer-progress
